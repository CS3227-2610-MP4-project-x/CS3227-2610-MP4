# Copy to .env.local and fill in real values. Never commit real values.
# Every variable here is server-only; none may be renamed with a NEXT_PUBLIC_ prefix.
#
# Environments (see "Environments and configuration" in docs/developer-guide.md):
#   local        .env.local on a developer machine, using development values
#   Preview/dev  Vercel Preview scope, restricted to the dev branch (development)
#   Production   Vercel Production scope, the master branch (production)
# Vercel's Development scope stays empty, and previews of other branches get no
# variables (E8). CI sets no application variable (D12, D13); its db-integration
# job sets only TEST_DATABASE_URL. Never reuse a credential across environments.
#
# Not variables, so not listed here:
# - The GitHub OAuth app client ID and client secret. They are entered only in
#   each environment's Supabase project, under the GitHub provider (E2).
# - AI quotas and rate limits. They are code constants selected by APP_ENV (E4).
# - The SoC LLM gateway base URL. It is a code constant (E3).

# Runtime database connection (D-A, D-J): the app_runtime role through the
# Supabase transaction pooler (port 6543). The pooler user has the form
# app_runtime.<project-ref>. Use a different password per environment.
# Set in: local, Preview/dev, Production.
DATABASE_URL=postgresql://app_runtime.<project-ref>:<app-runtime-password>@<pooler-host>:6543/postgres?sslmode=verify-full

# Supabase root CA certificate (D-J), PEM text from the project's Database
# settings > SSL Configuration. Public, not a secret; the app verifies the
# database certificate against it. Keep the quotes so the line breaks survive.
# Set in: local, Preview/dev, Production.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
<certificate body>
-----END CERTIFICATE-----"

# Integration tests only (D-K): superuser connection to a disposable local or CI
# PostgreSQL container. Never point this at a Supabase database.
# Set in: the shell that runs npm run test:integration (Vitest does not load
# .env.local), and the CI db-integration job. Never in Vercel.
TEST_DATABASE_URL=postgresql://postgres:<throwaway-password>@localhost:54329/postgres

# GitHub token encryption key (D-H, task 5.1): 32 random bytes, base64-encoded.
# Use a different key per environment. The developer guide shows how to
# generate one.
# Set in: local, Preview/dev, Production.
GITHUB_TOKEN_ENCRYPTION_KEY=<base64-32-bytes>

# Supabase project URL (E1), https://<project-ref>.supabase.co, used by
# server-side Supabase Auth for GitHub sign-in and sessions. Each environment
# uses its own Supabase project.
# Set in: local, Preview/dev, Production.
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable key (E1), from the project's API Keys settings. Not a
# secret, but kept server-only like every variable here. Never use a Supabase
# secret or service_role key in its place.
# Set in: local, Preview/dev, Production.
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# The environment's own origin (E7). Sign-in builds its redirect URL from it,
# never from the request's Host header. Locally http://localhost:3000; on
# Preview/dev the stable Vercel URL of the dev branch; on Production the
# production domain. It is also the Supabase project's Site URL (E2).
# Set in: local, Preview/dev, Production.
APP_ORIGIN=http://localhost:3000

# Environment name (E6): development or production; no other value is
# accepted. Selects the AI quota table (E4) and is stored with usage records.
# development locally, in CI, and on Preview/dev; production only on
# Production. NODE_ENV and VERCEL_ENV are not used for this.
# Set in: local, Preview/dev, Production.
APP_ENV=development

# SoC LLM adapter selection (E3): fake or soclaas, with no implicit default.
# fake is the deterministic test adapter and the local default. soclaas
# requires SOCLAAS_API_KEY and SOCLAAS_MODEL. Production refuses fake.
# Set in: local (usually fake), Preview/dev, Production (soclaas).
AI_PROVIDER=fake

# SoCLaaS API key (E3, "Keys per environment"). Required only when
# AI_PROVIDER is soclaas; may stay as this placeholder while it is fake.
# Development uses a key from thegrimbee's SoC account and production one
# from Lim-ZY's. Never share one between environments.
# Set in: local (only when needed), Preview/dev, Production.
SOCLAAS_API_KEY=<soclaas-api-key>

# SoCLaaS model (E3, SoC LLM and Quota Decisions "Model"): the pinned model
# name, not the default alias. Required when AI_PROVIDER is soclaas.
# Set in: local, Preview/dev, Production.
SOCLAAS_MODEL=qwen3.6:35b

# Operator-only migration connection (E9, D-A, D10): the Supabase postgres role
# through the session pooler (port 5432), read by the Supabase CLI, psql, and
# pg_dump. The application never reads it. Kept commented out on purpose.
# Set in: the operator's shell for one session only (see the developer guide).
# Never in .env.local, Vercel, or CI.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=<path-to-ca>
